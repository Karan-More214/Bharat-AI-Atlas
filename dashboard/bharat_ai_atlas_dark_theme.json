{
  "name": "Bharat AI Atlas Dark",
  "dataColors": ["#3987E5", "#D95926", "#199E70", "#C98500", "#D55181", "#9085E9", "#E66767", "#008300"],
  "background": "#111A2E",
  "foreground": "#FFFFFF",
  "tableAccent": "#3987E5",
  "good": "#2FBF71",
  "neutral": "#E0A526",
  "bad": "#E66767",
  "maximum": "#3987E5",
  "center": "#1E3A66",
  "minimum": "#16213A",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Bold", "color": "#FFFFFF" },
    "title":   { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#A9B4C7" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111A2E" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1F2B45" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{ "show": true, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "fontColor": { "solid": { "color": "#FFFFFF" } } }],
        "subTitle": [{ "show": true, "fontSize": 9, "fontFamily": "Segoe UI", "fontColor": { "solid": { "color": "#8C98B0" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#C9D2E3" } }, "fontSize": 10, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#8C98B0" } }, "fontSize": 9, "showAxisTitle": false, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#1F2B45" } }, "gridlineThickness": 1 }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#E6EBF5" } }, "fontSize": 9 }],
        "legend": [{ "labelColor": { "solid": { "color": "#C9D2E3" } }, "fontSize": 10 }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#0B1220" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#070C17" } }, "transparency": 0 }]
      }
    },
    "textbox": { "*": { "background": [{ "show": false }], "border": [{ "show": false }] } },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#16213A" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "textSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#C9D2E3" } }, "background": { "solid": { "color": "#16213A" } }, "textSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#1F2B45" } }, "gridVertical": false, "rowPadding": 3 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#16213A" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6EBF5" } }, "backColorPrimary": { "solid": { "color": "#111A2E" } }, "fontColorSecondary": { "solid": { "color": "#E6EBF5" } }, "backColorSecondary": { "solid": { "color": "#131E34" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#16213A" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#16213A" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#E6EBF5" } }, "backColor": { "solid": { "color": "#111A2E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6EBF5" } }, "backColorPrimary": { "solid": { "color": "#111A2E" } } }]
      }
    }
  }
}
